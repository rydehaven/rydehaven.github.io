{
  "rules": {
    ".read": false,
    ".write": false,
    "chat": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-z0-9-]{1,40}$/)",
        "$msg": {
          ".write": "auth != null && !data.exists() && $room.matches(/^[a-z0-9-]{1,40}$/)",
          ".validate": "newData.hasChildren(['u', 'n', 'x', 't']) && newData.parent().parent().parent().child('last').child(auth.uid).val() === now",
          "u": {
            ".validate": "newData.val() === auth.uid"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
          },
          "x": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140"
          },
          "c": {
            ".validate": "newData.isString() && newData.val().length === 2"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "last": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || data.val() <= now - 2000)"
      }
    },
    "live": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z0-9]{6}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{6}$/) && (!data.exists() || data.child('o').val() === auth.uid)",
        ".validate": "newData.child('o').val() === auth.uid"
      }
    },
    "cmd": {
      "$code": {
        ".read": "auth != null && root.child('live').child($code).child('o').val() === auth.uid",
        "$id": {
          ".write": "auth != null && root.child('live').child($code).exists() && (!data.exists() || root.child('live').child($code).child('o').val() === auth.uid)",
          ".validate": "newData.hasChildren(['a', 't']) && newData.child('t').val() === now && newData.child('a').isString() && newData.child('a').val().length <= 12 && (!newData.child('k').exists() || (newData.child('k').isString() && newData.child('k').val().length <= 12)) && (!newData.child('i').exists() || newData.child('i').isNumber())"
        }
      }
    }
  }
}