{
  "rules": {
    ".read": false,
    ".write": false,
    "chat": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-z0-9-]{1,40}$/)",
        "$msg": {
          ".write": "auth != null && !data.exists() && $room.matches(/^[a-z0-9-]{1,40}$/)",
          ".validate": "newData.hasChildren(['u', 'n', 'x', 't']) && newData.parent().parent().parent().child('last').child(auth.uid).val() === now",
          "u": { ".validate": "newData.val() === auth.uid" },
          "n": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "x": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
          "c": { ".validate": "newData.isString() && newData.val().length === 2" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "last": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || data.val() <= now - 2000)"
      }
    }
  }
}
